JWT_SECRET=replace-with-a-long-random-secret
SERVER_PORT=8080
JWT_EXPIRATION_HOURS=24
DATABASE_DIRECTORY=data
DATABASE_DIRECTORY_FILE=metadata.db
ALLOWED_ORIGINS=http://localhost:3000

# Enable only after configuring SMTP and deploying the frontend /verify-email flow.
EMAIL_VERIFICATION_ENABLED=false
# Recovery uses the same SMTP settings, independently of signup verification.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TTL_MINUTES=30
APP_PUBLIC_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (usually port 587) or tls (usually port 465); plaintext is rejected.
SMTP_TLS_MODE=starttls
# Optional PEM CA bundle for a private SMTP server; system trust is retained.
SMTP_CA_FILE=

# Optional GitHub sign-in. Register a GitHub OAuth app and deploy the frontend callback first.
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Frontend callback, registered verbatim in the OAuth app; HTTPS outside loopback.
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/auth/github/callback
